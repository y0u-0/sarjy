{
	"name": "sarjy-sql",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/node": "^22.13.14",
			"@types/bun": "^1.3.14",
			"next-themes": "^0.4.6",
			"react": "^19.2.6",
			"react-dom": "^19.2.6",
			"@libsql/client": "0.15.15",
			"libsql": "0.5.22",
			"@orpc/server": "^1.13.14",
			"@orpc/client": "^1.13.14",
			"@orpc/openapi": "^1.13.14",
			"@orpc/zod": "^1.13.14",
			"better-auth": "1.6.11",
			"@types/react": "^19.2.15",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"db:push": "turbo -F @sarjy-sql/db db:push",
		"db:studio": "turbo -F @sarjy-sql/db db:studio",
		"db:generate": "turbo -F @sarjy-sql/db db:generate",
		"db:migrate": "turbo -F @sarjy-sql/db db:migrate",
		"db:local": "turbo -F @sarjy-sql/db db:local",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@sarjy-sql/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@sarjy-sql/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.9.16",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.10"
}
